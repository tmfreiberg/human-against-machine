# ---- Line endings ----
# LF in the repository and in every working copy. This file does the
# normalising; core.autocrlf stays false.
* text=auto eol=lf

# Notebooks are JSON and follow the rule above. Their outputs are committed
# because the book is rendered from them: never strip them.

# ---- Binary ----
# Never diffed, never converted.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.onnx binary
*.pth binary
*.zip binary
